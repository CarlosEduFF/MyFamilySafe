PORT=8080

# Session pooler do Supabase — IPv4, exigido pelo Render. Ver "Deploy" abaixo.
# NÃO use db.xxxxx.supabase.co (conexão direta): é IPv6-only.
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.xxxxxxxxxxxx   # no pooler o user inclui o project ref
DB_PASSWORD=troque-me
DB_NAME=postgres
DB_SSL=require                   # 'disable' no docker-compose local

DB_POOL_SIZE=5                   # ver nota de conexões em "Deploy"

JWT_SECRET=troque-me
JWT_REFRESH_SECRET=troque-me-tambem-e-diferente-do-de-cima
CORS_ORIGINS=http://localhost:3000